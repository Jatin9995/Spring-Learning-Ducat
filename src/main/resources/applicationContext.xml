<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
<!-- autowire used here. byName autowire used. in this bean name & property name are same. so spring will autowire by name. -->
    <!-- <bean name="emp1" class="com.learning.spring.entity.Employee" autowire="byName"> -->

    <!-- byType autowire used here. in this bean name & property name are different. so spring will autowire by type. Type means datatype. -->
    <!-- Prototype = Every request par new object.  -->
    <bean name="emp1" class="com.learning.spring.entity.Employee" autowire="byType" scope="prototype">
    <property name="id" value="7"/>
    <property name="name" value="Jatin"/>
    <property name="gender" value="male"/>    
    </bean> 


<!-- primary=true islye user karte hai ddress me taaki maan lo hamare paas 2 address hai to employee bean ko batana padega ki kisko priority dena hai means kis address ko lena hai. -->
    <bean name="add" class="com.learning.spring.entity.Address" primary="true" >
    <property name="city" value="Noida"/>
    <property name="state" value="UP"/>
    </bean>



 

    
</beans>